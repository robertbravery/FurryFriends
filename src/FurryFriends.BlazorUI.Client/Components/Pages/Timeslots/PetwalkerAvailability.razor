@page "/petwalker/availability"
@page "/petwalker/{PetWalkerId:guid}/availability"
@rendermode InteractiveAuto
@using FurryFriends.BlazorUI.Client.Components.Common
@using FurryFriends.BlazorUI.Client.Models.PetWalkers
@using FurryFriends.BlazorUI.Client.Services.Interfaces

<PageTitle>Manage Availability - FurryFriends</PageTitle>

<div class="availability-container">
    <div class="availability-header">
        <div>
            <h1>Manage Availability</h1>
            <p>Set your weekly hours once &mdash; bookable slots are generated automatically.</p>
        </div>
        @if (SelectedPetWalkerId != Guid.Empty)
        {
            <button class="btn btn-primary" @onclick="SaveScheduleAsync" disabled="@_isSaving">
                <i class="fa-solid fa-floppy-disk"></i> Save Weekly Schedule
            </button>
        }
    </div>

    <div class="availability-context-bar">
        <div class="context-item context-item-grow">
            <label class="context-label" for="walker-select">Pet Walker</label>
            <select id="walker-select" class="form-select" value="@SelectedPetWalkerId"
                    @onchange="OnPetWalkerChangedAsync" disabled="@(!_petWalkers.Any())">
                <option value="">-- Select a pet walker --</option>
                @foreach (var walker in _petWalkers)
                {
                    <option value="@walker.Id">@walker.Name</option>
                }
            </select>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@_successMessage</span>
            <button class="btn-close" aria-label="Dismiss" @onclick="ClearSuccess"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@_errorMessage</span>
        </div>
    }

    @if (_isLoading)
    {
        <SkeletonLoader Type="SkeletonType.Table" Rows="4" Columns="3" />
    }
    else if (SelectedPetWalkerId == Guid.Empty)
    {
        <EmptyState IconClass="fa-solid fa-hand-pointer"
                    Title="Select a Pet Walker"
                    Description="Choose a pet walker above to configure their availability." />
    }
    else
    {
        <div class="tabs">
            <button class="tab-btn @(_activeTab == AvailabilityTab.Schedule ? "active" : "")" @onclick="() => SetTab(AvailabilityTab.Schedule)">
                Weekly Schedule
            </button>
            <button class="tab-btn @(_activeTab == AvailabilityTab.Exceptions ? "active" : "")" @onclick="() => SetTab(AvailabilityTab.Exceptions)">
                Date Exceptions
            </button>
            <button class="tab-btn @(_activeTab == AvailabilityTab.Settings ? "active" : "")" @onclick="() => SetTab(AvailabilityTab.Settings)">
                Slot Settings
            </button>
            <button class="tab-btn @(_activeTab == AvailabilityTab.Requests ? "active" : "")" @onclick="() => SetTab(AvailabilityTab.Requests)">
                Custom Requests
            </button>
        </div>

        @if (_activeTab == AvailabilityTab.Schedule)
        {
            <div class="tab-content">
                <p class="section-description">
                    Tick the days you work and set your hours. Each day is split into
                    <strong>@_settings.SlotDurationMinutes minute</strong> slots, minus any time already booked.
                </p>

                <div class="week-grid">
                    @foreach (var day in WeekDays)
                    {
                        var item = ScheduleFor(day);
                        <div class="day-row @(item.IsActive ? "active" : "")">
                            <label class="day-toggle">
                                <input type="checkbox" checked="@item.IsActive"
                                       @onchange="e => ToggleDay(day, e)" />
                                <span class="day-name">@day</span>
                            </label>

                            <div class="time-controls @(item.IsActive ? "" : "disabled")">
                                <input type="time" class="form-control" value="@item.StartTime.ToString("HH:mm")"
                                       disabled="@(!item.IsActive)" @onchange="e => SetStartTime(day, e)" />
                                <span class="time-separator">to</span>
                                <input type="time" class="form-control" value="@item.EndTime.ToString("HH:mm")"
                                       disabled="@(!item.IsActive)" @onchange="e => SetEndTime(day, e)" />
                            </div>

                            <span class="slot-hint">
                                @if (item.IsActive)
                                {
                                    @($"{SlotCountFor(item)} slots")
                                }
                                else
                                {
                                    <span class="muted">Not working</span>
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_activeTab == AvailabilityTab.Exceptions)
        {
            <div class="tab-content">
                <div class="section-header">
                    <p class="section-description">
                        Override a single date without changing your weekly pattern &mdash; holidays, sickness, or one-off hours.
                    </p>
                    <button class="btn btn-primary" @onclick="OpenExceptionDialog">
                        <i class="fa-solid fa-plus"></i> Add Exception
                    </button>
                </div>

                @if (_dateExceptions.Any())
                {
                    <div class="data-table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Availability</th>
                                    <th>Reason</th>
                                    <th class="actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exception in _dateExceptions.OrderBy(e => e.Date))
                                {
                                    <tr>
                                        <td>@exception.Date.ToString("ddd, dd MMM yyyy")</td>
                                        <td>
                                            <span class="status-chip @(exception.IsUnavailable ? "danger" : "info")">
                                                @exception.HoursDisplay
                                            </span>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(exception.Reason) ? "-" : exception.Reason)</td>
                                        <td class="actions-cell">
                                            <IconButton IconClass="fa-solid fa-trash" Title="Remove exception"
                                                        Color="IconButtonColor.Danger" Size="IconButtonSize.Small"
                                                        OnClick="() => DeleteExceptionAsync(exception)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <EmptyState IconClass="fa-solid fa-calendar-day"
                                Title="No Date Exceptions"
                                Description="Your weekly schedule applies to every date. Add an exception to override a specific day." />
                }
            </div>
        }
        else if (_activeTab == AvailabilityTab.Settings)
        {
            <div class="tab-content">
                <p class="section-description">
                    These control how a day's hours are turned into bookable slots.
                </p>

                <div class="settings-form">
                    <div class="form-group">
                        <label class="form-label" for="slot-duration">Slot length (minutes)</label>
                        <input id="slot-duration" type="number" class="form-control" min="15" max="480" step="15"
                               @bind="_settings.SlotDurationMinutes" />
                        <small class="form-text">Each slot offered to clients is this long. 15&ndash;480 minutes.</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="gap">Gap between bookings (minutes)</label>
                        <input id="gap" type="number" class="form-control" min="0" max="240" step="5"
                               @bind="_settings.InterBookingGapMinutes" />
                        <small class="form-text">Travel and setup time. Slots touching an existing booking by this much are withheld. 0&ndash;240 minutes.</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="daily-limit">Maximum walks per day</label>
                        <input id="daily-limit" type="number" class="form-control" min="1" max="50"
                               @bind="_settings.DailyPetWalkLimit" />
                        <small class="form-text">No further slots are offered once this many walks are booked.</small>
                    </div>

                    <div class="settings-actions">
                        <button class="btn btn-primary" @onclick="SaveSettingsAsync" disabled="@_isSaving">
                            <i class="fa-solid fa-floppy-disk"></i> Save Settings
                        </button>
                    </div>
                </div>
            </div>
        }
        else if (_activeTab == AvailabilityTab.Requests)
        {
            <div class="tab-content">
                <div class="section-header">
                    <p class="section-description">Ad-hoc times clients have asked for outside your weekly hours.</p>
                    <div class="filter-group">
                        <select class="form-select" @onchange="OnStatusFilterChanged">
                            <option value="">All Requests</option>
                            <option value="Pending">Pending</option>
                            <option value="Accepted">Accepted</option>
                            <option value="Declined">Declined</option>
                            <option value="CounterOffered">Counter-Offered</option>
                        </select>
                    </div>
                </div>

                @if (_customRequests.Any())
                {
                    <div class="requests-list">
                        @foreach (var request in _customRequests)
                        {
                            <div class="request-card">
                                <div class="request-header">
                                    <h3>Request from @request.ClientName</h3>
                                    <span class="status-chip @RequestStatusClass(request.Status)">@request.Status</span>
                                </div>
                                <div class="request-details">
                                    <p><strong>Date:</strong> @request.RequestedDate.ToString("yyyy-MM-dd")</p>
                                    <p><strong>Preferred time:</strong> @request.PreferredStartTime.ToString("HH:mm") - @request.PreferredEndTime.ToString("HH:mm")</p>
                                    <p><strong>Duration:</strong> @request.PreferredDurationMinutes minutes</p>
                                    <p><strong>Address:</strong> @request.ClientAddress</p>
                                    @if (request.PetNames.Any())
                                    {
                                        <p><strong>Pets:</strong> @string.Join(", ", request.PetNames)</p>
                                    }
                                    <p><strong>Requested:</strong> @request.CreatedAt.ToString("g")</p>
                                </div>
                                @if (request.Status == "Pending")
                                {
                                    <div class="request-actions">
                                        <button class="btn btn-primary" @onclick="() => AcceptRequest(request.RequestId)">Accept</button>
                                        <button class="btn btn-danger" @onclick="() => DeclineRequest(request.RequestId)">Decline</button>
                                        <button class="btn btn-secondary" @onclick="() => ShowCounterOfferDialog(request)">Counter Offer</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <EmptyState IconClass="fa-solid fa-inbox"
                                Title="No Custom Requests"
                                Description="Clients can request specific times outside your weekly hours." />
                }
            </div>
        }
    }

    <!-- Date exception dialog -->
    @if (_showExceptionDialog)
    {
        <div class="modal-overlay" @onclick="CloseExceptionDialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-icon primary">
                        <i class="fa-solid fa-calendar-day"></i>
                    </div>
                    <h3>Add Date Exception</h3>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label" for="exception-date">Date *</label>
                        <input id="exception-date" type="date" class="form-control" @bind="_exceptionForm.Date" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="exception-kind">Availability *</label>
                        <select id="exception-kind" class="form-select" @bind="_exceptionForm.IsUnavailable">
                            <option value="true">Unavailable all day</option>
                            <option value="false">Different hours</option>
                        </select>
                    </div>

                    @if (!_exceptionForm.IsUnavailable)
                    {
                        <div class="form-group time-pair">
                            <div>
                                <label class="form-label" for="exception-start">Start</label>
                                <input id="exception-start" type="time" class="form-control" @bind="_exceptionForm.StartTime" />
                            </div>
                            <div>
                                <label class="form-label" for="exception-end">End</label>
                                <input id="exception-end" type="time" class="form-control" @bind="_exceptionForm.EndTime" />
                            </div>
                        </div>
                    }

                    <div class="form-group">
                        <label class="form-label" for="exception-reason">Reason</label>
                        <input id="exception-reason" type="text" class="form-control" maxlength="200"
                               placeholder="Optional, e.g. public holiday" @bind="_exceptionForm.Reason" />
                    </div>
                </div>
                <div class="modal-actions">
                    <button class="btn btn-secondary" @onclick="CloseExceptionDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveExceptionAsync" disabled="@_isSaving">
                        <i class="fa-solid fa-floppy-disk"></i> Save Exception
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Counter offer dialog -->
    @if (_showCounterOfferDialog && _selectedRequest != null)
    {
        <div class="modal-overlay" @onclick="CloseCounterOfferDialog">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-icon primary">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                    <h3>Counter Offer</h3>
                </div>
                <div class="modal-body">
                    <p>Suggest an alternative time for the client.</p>
                    <div class="form-group">
                        <label class="form-label" for="counter-date">Date</label>
                        <input id="counter-date" type="date" class="form-control" @bind="_counterOfferForm.Date" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="counter-start">Start time</label>
                        <input id="counter-start" type="time" class="form-control" @bind="_counterOfferForm.StartTime" />
                    </div>
                </div>
                <div class="modal-actions">
                    <button class="btn btn-secondary" @onclick="CloseCounterOfferDialog">Cancel</button>
                    <button class="btn btn-primary" @onclick="SubmitCounterOffer" disabled="@_isSaving">
                        <i class="fa-solid fa-paper-plane"></i> Send Counter Offer
                    </button>
                </div>
            </div>
        </div>
    }
</div>
